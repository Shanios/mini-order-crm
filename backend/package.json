{
  "name": "mini-order-crm-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node -e \"for (const f of require('node:fs').readdirSync('test').filter((name) => name.endsWith('.test.cjs'))) require('./test/' + f)\"",
    "prisma:generate": "node scripts/assert-root-env.cjs && dotenv -e ../.env --override -- prisma generate",
    "prisma:validate": "node scripts/assert-root-env.cjs && dotenv -e ../.env --override -- prisma validate",
    "prisma:status": "node scripts/assert-root-env.cjs && dotenv -e ../.env --override -- prisma migrate status",
    "prisma:check": "node scripts/assert-root-env.cjs && dotenv -e ../.env --override -- node scripts/check-database.cjs",
    "prisma:migrate": "node scripts/assert-root-env.cjs && dotenv -e ../.env --override -- prisma migrate dev",
    "prisma:deploy": "node scripts/assert-root-env.cjs && dotenv -e ../.env --override -- prisma migrate deploy",
    "webhooks:register": "node scripts/register-webhooks.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.12",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "^6.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
