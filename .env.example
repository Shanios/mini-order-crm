# Copy this file to the repository root as .env. Backend runtime and Prisma
# commands are intentionally configured to load only that root .env file.

# Used only by the optional local Docker Compose PostgreSQL service.
POSTGRES_DB=mini_order_crm
POSTGRES_USER=mini_order_crm
POSTGRES_PASSWORD=replace_with_a_local_database_password

# PostgreSQL connection used by NestJS and Prisma.
DATABASE_URL=postgresql://mini_order_crm:replace_with_a_local_database_password@localhost:5432/mini_order_crm?schema=public

# NestJS settings. Keep API_PORT at 3000 unless you also update the Vite proxy.
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Shopify app settings. Use your own development store and app credentials.
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_shopify_app_client_id
SHOPIFY_CLIENT_SECRET=replace_with_shopify_app_client_secret
SHOPIFY_API_VERSION=2026-10

# Required only to call the backend manual sync endpoint. Use a unique random
# value of at least 32 characters.
SHOPIFY_SYNC_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters

# Optional backend-only bearer credential for trusted internal order creation.
# Browser order creation uses the operator session instead.
SHOPIFY_ORDER_CREATE_SECRET=replace_with_an_optional_unique_random_secret_of_at_least_32_characters

# Single CRM operator. Generate the password hash with the helper in README.md.
CRM_OPERATOR_USERNAME=operator
CRM_OPERATOR_PASSWORD_HASH=replace_with_output_from_hash_operator_password_helper

# Server-only signing secret; generate an independent random value of 32+ chars.
CRM_SESSION_SECRET=replace_with_a_unique_random_session_secret_of_at_least_32_characters

# Optional fixed session lifetime in minutes (5-1440; defaults to 480).
CRM_SESSION_TTL_MINUTES=480
